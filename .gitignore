# MATLAB artifacts
*.asv
*.autosave
*.mex*
*.slxc
slprj/
codegen/
octave-workspace

# macOS
.DS_Store

# Local-only data. datasets/ holds full downloads (e.g. all 45 classes of
# NWPU-RESISC45); each homework folder checks in only the subset it uses.
/datasets/

# Per-machine Claude Code and MATLAB MCP setup. These hold absolute
# /Users/... paths and are regenerated by setupAgenticToolkit, so they
# break on any other machine. startup.m only shares the MATLAB session
# with the MCP server.
.claude/
.mcp.json
/startup.m
